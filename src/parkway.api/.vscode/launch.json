{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "C#: ParkwayAPI Debug (HTTPS)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/bin/Debug/net8.0/parkway.api.dll",
        "args": [],
        "cwd": "${workspaceFolder}",
        "stopAtEntry": false,
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
        },
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "https://localhost:5443;http://localhost:5122"
        },
        "console": "internalConsole"
      }
    ]
  }
  